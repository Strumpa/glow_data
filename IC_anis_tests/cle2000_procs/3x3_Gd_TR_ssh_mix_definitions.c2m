PARAMETER LIBRARY ::
::: LINKED_LIST LIBRARY ; ;

! Library name, ssh method
STRING Library ssh_method ;
:: >>Library<<  >>ssh_method<< ;
INTEGER anis_level ;
:: >>anis_level<< ; ! Anisotropy level
STRING tran_correc ;
:: >>tran_correc<< ; ! Transport correction option
DOUBLE DTFUEL DTBOX DTCLAD DTCOOL DTMODE ;
:: >>DTFUEL<< >>DTBOX<< >>DTCLAD<< >>DTCOOL<< >>DTMODE<< ; ! Temperatures

* --------------------------------------------
*  CONVERT DOUBLE TO REALS for TEMPERATURES
* --------------------------------------------
REAL TFUEL := DTFUEL D_TO_R ;
REAL TBOX := DTBOX D_TO_R ;
REAL TCLAD := DTCLAD D_TO_R ;
REAL TCOOL := DTCOOL D_TO_R ;
REAL TMODE := DTMODE D_TO_R ;

*    STRUCTURES AND MODULES
* -------------------------------
MODULE  LIB: UTL: DELETE: END: ABORT: ;

* --------------------------------
*    MIX INDEX ASSIGNMENTS
* --------------------------------
* -- Fuel mixes --
*     13 : 24UOX_zone_1 (generating)
*     12 : 24UOX_zone_2 (daughter of mix 13)
*     11 : 24UOX_zone_3 (daughter of mix 13)
*     10 : 24UOX_zone_4 (daughter of mix 13)
*      9 : 45Gd_zone_1 (generating)
*      8 : 45Gd_zone_2 (daughter of mix 9)
*      7 : 45Gd_zone_3 (daughter of mix 9)
*      6 : 45Gd_zone_4 (daughter of mix 9)
*      5 : 45Gd_zone_5 (daughter of mix 9)
*      4 : 45Gd_zone_6 (daughter of mix 9)
* -- Non-fuel mixes --
*      1 : COOLANT
*      2 : CLAD
*      3 : GAP

* --------------------------------
*    MIX COMPOSITION DEFINITION
*    CALL TO LIB: MODULE
* --------------------------------
LIBRARY := LIB: ::
EDIT 0
NMIX 13  ! MAXIMUM OF MATERIAL MIXTURES
<<ssh_method>>
ANIS <<anis_level>>
CTRA <<tran_correc>>
DEPL LIB: DRAGON FIL: <<Library>>
MIXS LIB: DRAGON FIL: <<Library>>
    MIX 13 <<TFUEL>> 
    U234 = U234 5.15910E-06 1
