* PROCEDURE TRK.c2m : tracking
* --------------------------------
* Procedure generated by starterDD
* --------------------------------
*    INPUT & OUTPUT PARAMETERS
* --------------------------------
PARAMETER TRKSSH TRKFILSSH TRKFLUX TRKFILFLUX tdtssh tdtflux ::
::: LINKED_LIST TRKSSH ;
::: SEQ_BINARY TRKFILSSH ;
::: LINKED_LIST TRKFLUX ;
::: SEQ_BINARY TRKFILFLUX ;
;

MODULE SALT: MCCGT: END: ;

* Tracking for step SSH
TRKSSH TRKFILSSH := SALT: tdtssh ::
    EDIT 2
    TITLE 'SSH - IC'
    ANIS 4
    TISO 8 25.0
    IC EPSJ 1.0E-5
;

* Tracking for step FLUX
TRKFLUX TRKFILFLUX := SALT: tdtflux ::
    EDIT 2
    TITLE 'FLUX - MOC'
    ANIS 4
    ALLG
    TSPC 24 40.0 REND
    NOIC
;

* MOC tracking for step FLUX
TRKFLUX := MCCGT: TRKFLUX TRKFILFLUX ::
    EDIT 1
    GAUS 4 AAC 80 TMT EPSI 1E-5
;

END: ;
QUIT .
