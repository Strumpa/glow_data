*PROCEDURE MIX_AT10_24UOX.c2m
* --------------------------------
* Procedure generated by starterDD
* Author: R. Guasch
* --------------------------------
*    INPUT & OUTPUT PARAMETERS
* --------------------------------
PARAMETER LIBRARY ::
::: LINKED_LIST LIBRARY ; ;

! Library name, ssh method
STRING Library ssh_method ;
:: >>Library<<  >>ssh_method<< ;
INTEGER anis_level ;
:: >>anis_level<< ; ! Anisotropy level
STRING tran_correc ;
:: >>tran_correc<< ; ! Transport correction option
REAL TFUEL TBOX TCLAD TCOOL TMODE TCTRL ;
:: >>TFUEL<< >>TBOX<< >>TCLAD<< >>TCOOL<< >>TMODE<< >>TCTRL<< ;
REAL N_H N_O ;
:: >>N_H<< >>N_O<< ;

* -------------------------------
*    STRUCTURES AND MODULES
* -------------------------------
MODULE  LIB: UTL: DELETE: END: ABORT: ;

* --------------------------------
*    MIX INDEX ASSIGNMENTS
* --------------------------------
* -- Fuel mixes --
*      7 : 24UOX_zone1_pin1 (generating)
*      6 : 24UOX_zone2_pin1 (daughter of mix 7)
*      5 : 24UOX_zone3_pin1 (daughter of mix 7)
*      4 : 24UOX_zone4_pin1 (daughter of mix 7)
* -- Non-fuel mixes --
*      1 : COOLANT
*      2 : CLAD
*      3 : GAP

* --------------------------------
*    MIX COMPOSITION DEFINITION
*    CALL TO LIB: MODULE
* --------------------------------
LIBRARY := LIB: ::
EDIT 0
NMIX 7  ! MAXIMUM OF MATERIAL MIXTURES
<<ssh_method>>
ANIS <<anis_level>>
CTRA <<tran_correc>>
DEPL LIB: DRAGON FIL: <<Library>>
MIXS LIB: DRAGON FIL: <<Library>>
    MIX 7 <<TFUEL>> 
    U234 = U234 5.15910E-06 1
    U235 = U235 5.67035E-04 1
    U238 = U238 2.27631E-02 1
    O16 = O16 4.66705E-02
    MIX 6 COMB 7 1.0
    MIX 5 COMB 7 1.0
    MIX 4 COMB 7 1.0
    MIX 1 <<TCOOL>> NOEV
    O16 = O16 <<N_O>>
    H1 = H1_H2O <<N_H>>

    MIX 2 <<TCLAD>> NOEV
    O16 = O16 3.08132E-04
    O17 = O17 1.17376E-07
    Cr50 = Cr50 3.29613E-06
    Cr52 = Cr52 6.35631E-05 2
    Cr53 = Cr53 7.20746E-06
    Cr54 = Cr54 1.79408E-06
    Fe54 = Fe54 5.57337E-06
    Fe56 = Fe56 8.74901E-05 2
    Fe57 = Fe57 2.02053E-06
    Fe58 = Fe58 2.68895E-07
    Ni58 = Ni58 2.51627E-05
    Ni60 = Ni60 9.69262E-06
    Ni61 = Ni61 4.21331E-07
    Ni62 = Ni62 1.34344E-06
    Ni64 = Ni64 3.42085E-07
    Zr90 = Zr90 2.18317E-02 2
    Zr91 = Zr91 4.76096E-03 2
    Zr92 = Zr92 7.27723E-03 2
    Zr94 = Zr94 7.37482E-03 2
    Zr96 = Zr96 1.18812E-03 2
    Sn112 = Sn112 4.67343E-06
    Sn114 = Sn114 3.17985E-06
    Sn115 = Sn115 1.63812E-06
    Sn116 = Sn116 7.00535E-05
    Sn117 = Sn117 3.70020E-05
    Sn118 = Sn118 1.16691E-04
    Sn119 = Sn119 4.13864E-05
    Sn120 = Sn120 1.56970E-04
    Sn122 = Sn122 2.23073E-05
    Sn124 = Sn124 2.78961E-05

    MIX 3 <<TFUEL>> NOEV
    He4 = He4 1.50456E-04

;
