*PROCEDURE MIX.c2m
* --------------------------------
* Procedure generated by starterDD
* Author: R. Guasch
* --------------------------------
*    INPUT & OUTPUT PARAMETERS
* --------------------------------
PARAMETER LIBRARY ::
::: LINKED_LIST LIBRARY ; ;

! Library name, ssh method
STRING Library ssh_method ;
:: >>Library<<  >>ssh_method<< ;
INTEGER anis_level ;
:: >>anis_level<< ; ! Anisotropy level
STRING tran_correc ;
:: >>tran_correc<< ; ! Transport correction option
REAL TFUEL TBOX TCLAD TCOOL TMODE TCTRL ;
:: >>TFUEL<< >>TBOX<< >>TCLAD<< >>TCOOL<< >>TMODE<< >>TCTRL<< ;

* -------------------------------
*    STRUCTURES AND MODULES
* -------------------------------
MODULE  LIB: UTL: DELETE: END: ABORT: ;

* --------------------------------
*    MIX INDEX ASSIGNMENTS
* --------------------------------
* -- Fuel mixes --
*      9 : 45Gd_zone_1 (generating)
*      8 : 45Gd_zone_2 (daughter of mix 9)
*      7 : 45Gd_zone_3 (daughter of mix 9)
*      6 : 45Gd_zone_4 (daughter of mix 9)
*      5 : 45Gd_zone_5 (daughter of mix 9)
*      4 : 45Gd_zone_6 (daughter of mix 9)
* -- Non-fuel mixes --
*      1 : COOLANT
*      2 : CLAD
*      3 : GAP

* --------------------------------
*    MIX COMPOSITION DEFINITION
*    CALL TO LIB: MODULE
* --------------------------------
LIBRARY := LIB: ::
EDIT 0
NMIX 9  ! MAXIMUM OF MATERIAL MIXTURES
PT CALENDF 4
ANIS <<anis_level>>
CTRA <<tran_correc>>
ADED 4 NELAS N2N N3N N4N
DEPL LIB: DRAGON FIL: <<Library>>
MIXS LIB: DRAGON FIL: <<Library>>
    MIX 9 <<TFUEL>> 
    U234 = U234 9.451580E-06 1
    U235 = U235 9.945290E-04 1
    U238 = U238 2.107540E-02 1
    O16 = O16 4.621410E-02
    Gd154 = Gd154 2.986510E-05
    Gd155 = Gd155 2.027540E-04
    Gd156 = Gd156 2.804310E-04
    Gd157 = Gd157 2.143990E-04
    Gd158 = Gd158 3.403000E-04
    Gd160 = Gd160 2.994740E-04
    MIX 8 COMB 9 1.0
    MIX 7 COMB 9 1.0
    MIX 6 COMB 9 1.0
    MIX 5 COMB 9 1.0
    MIX 4 COMB 9 1.0
    MIX 1 <<TCOOL>> NOEV
    O16 = O16 2.472980E-02
    H1 = H1_H2O 4.945460E-02

    MIX 2 <<TCLAD>> NOEV
    O16 = O16 3.081320E-04
    O17 = O17 1.173760E-07
    Cr50 = Cr50 3.296130E-06
    Cr52 = Cr52 6.356310E-05
    Cr53 = Cr53 7.207460E-06
    Cr54 = Cr54 1.794080E-06
    Fe54 = Fe54 5.573370E-06
    Fe56 = Fe56 8.749010E-05 2
    Fe57 = Fe57 2.020530E-06
    Fe58 = Fe58 2.688950E-07
    Ni58 = Ni58 2.516270E-05
    Ni60 = Ni60 9.692620E-06
    Ni61 = Ni61 4.213310E-07
    Ni62 = Ni62 1.343440E-06
    Ni64 = Ni64 3.420850E-07
    Zr90 = Zr90 2.183170E-02 2
    Zr91 = Zr91 4.760960E-03 2
    Zr92 = Zr92 7.277230E-03 2
    Zr94 = Zr94 7.374820E-03 2
    Zr96 = Zr96 1.188120E-03 2
    Sn112 = Sn112 4.673430E-06
    Sn114 = Sn114 3.179850E-06
    Sn115 = Sn115 1.638120E-06
    Sn116 = Sn116 7.005350E-05
    Sn117 = Sn117 3.700200E-05
    Sn118 = Sn118 1.166910E-04
    Sn119 = Sn119 4.138640E-05
    Sn120 = Sn120 1.569700E-04
    Sn122 = Sn122 2.230730E-05
    Sn124 = Sn124 2.789610E-05

    MIX 3 <<TFUEL>> NOEV
    He4 = He4 1.504560E-04

;
* -----------------------------------------
*         END OF LIBRARY DEFINITION
* -----------------------------------------
END: ;
QUIT .