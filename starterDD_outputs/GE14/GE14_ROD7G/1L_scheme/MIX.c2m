    Hf177 = Hf177 4.116857E-07
    Hf178 = Hf178 6.038071E-07
    Hf179 = Hf179 3.014605E-07
    Hf180 = Hf180 7.764483E-07

    MIX 3 <<TFUEL>> NOEV
    He4 = He4 2.687139E-05

;
* -----------------------------------------
*         END OF LIBRARY DEFINITION
* -----------------------------------------
END: ;
QUIT .