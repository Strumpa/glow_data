*PROCEDURE MIX.c2m
* --------------------------------
* Procedure generated by starterDD
* Author: R. Guasch
* --------------------------------
*    INPUT & OUTPUT PARAMETERS
* --------------------------------
PARAMETER LIBRARY ::
::: LINKED_LIST LIBRARY ; ;

! Library name, ssh method
STRING Library ssh_method ;
:: >>Library<<  >>ssh_method<< ;
INTEGER anis_level ;
:: >>anis_level<< ; ! Anisotropy level
STRING tran_correc ;
:: >>tran_correc<< ; ! Transport correction option
REAL TFUEL TBOX TCLAD TCOOL TMODE TCTRL ;
:: >>TFUEL<< >>TBOX<< >>TCLAD<< >>TCOOL<< >>TMODE<< >>TCTRL<< ;

* -------------------------------
*    STRUCTURES AND MODULES
* -------------------------------
MODULE  LIB: UTL: DELETE: END: ABORT: ;

* --------------------------------
*    MIX INDEX ASSIGNMENTS
* --------------------------------
* -- Fuel mixes --
*      9 : UOX49Gd8_zone_1 (generating)
*      8 : UOX49Gd8_zone_2 (daughter of mix 9)
*      7 : UOX49Gd8_zone_3 (daughter of mix 9)
*      6 : UOX49Gd8_zone_4 (daughter of mix 9)
*      5 : UOX49Gd8_zone_5 (daughter of mix 9)
*      4 : UOX49Gd8_zone_6 (daughter of mix 9)
* -- Non-fuel mixes --
*      1 : COOLANT
*      2 : CLAD
*      3 : GAP

* --------------------------------
*    MIX COMPOSITION DEFINITION
*    CALL TO LIB: MODULE
* --------------------------------
LIBRARY := LIB: ::
EDIT 0
NMIX 9  ! MAXIMUM OF MATERIAL MIXTURES
PT CALENDF 4
ANIS <<anis_level>>
CTRA <<tran_correc>>
ADED 4 NELAS N2N N3N N4N
DEPL LIB: DRAGON FIL: <<Library>>
MIXS LIB: DRAGON FIL: <<Library>>
    MIX 9 <<TFUEL>> 
    U235 = U235 1.037433E-03 1
    U234 = U234 9.272726E-06 1
    U236 = U236 4.751941E-06
    U238 = U238 1.986652E-02 1
    Gd152 = Gd152 5.417362E-06
    Gd154 = Gd154 5.904828E-05 1
    Gd155 = Gd155 4.008765E-04 1
    Gd156 = Gd156 5.544573E-04 1
    Gd157 = Gd157 4.239013E-04 1
    Gd158 = Gd158 6.728237E-04 1
    Gd160 = Gd160 5.921081E-04 1
    O16 = O16 4.589891E-02
    MIX 8 COMB 9 1.0
    MIX 7 COMB 9 1.0
    MIX 6 COMB 9 1.0
    MIX 5 COMB 9 1.0
    MIX 4 COMB 9 1.0
    MIX 1 <<TCOOL>> NOEV
    H1 = H1_H2O 4.926497E-02
    O16 = O16 2.463249E-02

    MIX 2 <<TCLAD>> NOEV
    Cr50 = Cr50 3.301214E-06
    Cr52 = Cr52 6.366102E-05
    Cr53 = Cr53 7.218584E-06
    Cr54 = Cr54 1.796843E-06
    Fe54 = Fe54 5.581994E-06
    Fe56 = Fe56 8.762564E-05
    Fe57 = Fe57 2.023656E-06
    Fe58 = Fe58 2.693080E-07
    Ni58 = Ni58 2.520143E-05
    Ni60 = Ni60 9.707621E-06
    Ni61 = Ni61 4.219811E-07
    Ni62 = Ni62 1.345474E-06
    Ni64 = Ni64 3.426500E-07
    Zr90 = Zr90 2.189099E-02 2
    Zr91 = Zr91 4.773885E-03 2
    Zr92 = Zr92 7.296982E-03 2
    Zr94 = Zr94 7.394852E-03 2
    Zr96 = Zr96 1.191345E-03 2
    Sn112 = Sn112 4.680680E-06
    Sn114 = Sn114 3.184785E-06
    Sn115 = Sn115 1.640647E-06
    Sn116 = Sn116 7.016152E-05
    Sn117 = Sn117 3.705920E-05
    Sn118 = Sn118 1.168714E-04
    Sn119 = Sn119 4.145042E-05
    Sn120 = Sn120 1.572124E-04
    Sn122 = Sn122 2.234175E-05
    Sn124 = Sn124 2.793916E-05
    Hf174 = Hf174 3.541387E-09
