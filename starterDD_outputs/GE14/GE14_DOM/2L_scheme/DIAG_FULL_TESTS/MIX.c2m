PARAMETER LIBRARY ::
::: LINKED_LIST LIBRARY ; ;

! Library name, ssh method
STRING Library ssh_method ;
:: >>Library<<  >>ssh_method<< ;
INTEGER anis_level ;
:: >>anis_level<< ; ! Anisotropy level
STRING tran_correc ;
:: >>tran_correc<< ; ! Transport correction option
REAL TFUEL TBOX TCLAD TCOOL TMODE TCTRL ;
:: >>TFUEL<< >>TBOX<< >>TCLAD<< >>TCOOL<< >>TMODE<< >>TCTRL<< ;

* -------------------------------
*    STRUCTURES AND MODULES
* -------------------------------
MODULE  LIB: UTL: DELETE: END: ABORT: ;

* --------------------------------
*    MIX INDEX ASSIGNMENTS
* --------------------------------
* -- Fuel mixes --
*      7 : UOX16_zone_1 (generating)
*      6 : UOX16_zone_2 (daughter of mix 7)
*      5 : UOX16_zone_3 (daughter of mix 7)
*      4 : UOX16_zone_4 (daughter of mix 7)
*     13 : UOX40Gd8_zone_1 (generating)
*     12 : UOX40Gd8_zone_2 (daughter of mix 13)
*     11 : UOX40Gd8_zone_3 (daughter of mix 13)
*     10 : UOX40Gd8_zone_4 (daughter of mix 13)
*      9 : UOX40Gd8_zone_5 (daughter of mix 13)
*      8 : UOX40Gd8_zone_6 (daughter of mix 13)
* -- Non-fuel mixes --
*      1 : COOLANT
*      2 : CLAD
*      3 : GAP
*     14 : MODERATOR
*     15 : CHANNEL_BOX

* --------------------------------
*    MIX COMPOSITION DEFINITION
*    CALL TO LIB: MODULE
* --------------------------------
LIBRARY := LIB: ::
EDIT 0
NMIX 15  ! MAXIMUM OF MATERIAL MIXTURES
PT CALENDF 4
ANIS <<anis_level>>
CTRA <<tran_correc>>
ADED 4 NELAS N2N N3N N4N
